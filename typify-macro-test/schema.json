{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MacroDependencies",
  "type": "object",
  "properties": {
    "anything": {},
    "date": {
      "type": "string",
      "format": "date"
    },
    "date_time": {
      "type": "string",
      "format": "date-time"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "pattern": {
      "type": "string",
      "pattern": "^[a-z]+$"
    }
  },
  "required": ["anything", "date", "date_time", "id", "pattern"]
}
