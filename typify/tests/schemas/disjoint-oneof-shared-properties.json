{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Elicitation": {
      "title": "Elicitation",
      "type": "object",
      "properties": {
        "serverName": { "type": "string" },
        "threadId": { "type": "string" }
      },
      "required": ["serverName", "threadId"],
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": { "type": "string", "enum": ["form"] },
            "requestedSchema": { "type": "object" },
            "_meta": true
          },
          "required": ["mode", "requestedSchema"]
        },
        {
          "type": "object",
          "properties": {
            "mode": { "type": "string", "enum": ["openai/form"] },
            "requestedSchema": true,
            "_meta": true
          },
          "required": ["mode", "requestedSchema"]
        }
      ]
    }
  }
}
